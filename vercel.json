{
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/produit/:slug/", "destination": "/produit/index.html" },
    { "source": "/produit/:slug", "destination": "/produit/index.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
